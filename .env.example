NEXT_PUBLIC_APP_URL=http://localhost:3000

# Local staff auth
STAFF_PASSWORD=district7-local
STAFF_SESSION_SECRET=
STAFF_SESSION_MAX_AGE_HOURS=12

# Address geocoding
GEOCODING_PROVIDER=census
GEOCODING_CENSUS_BENCHMARK=Public_AR_Current
GEOCODING_TIMEOUT_MS=4000
DISTRICT_7_MATCH_KEYWORDS=
DISTRICT_7_OUTSIDE_KEYWORDS=

# Intake hardening
REPORT_MAX_PHOTOS=4
REPORT_RATE_LIMIT_ENABLED=true
REPORT_RATE_LIMIT_WINDOW_MINUTES=60
REPORT_RATE_LIMIT_MAX_PER_IP=12
REPORT_RATE_LIMIT_MAX_PER_EMAIL=4
RATE_LIMIT_SECRET=

# Optional AI routing
OPENAI_API_KEY=your-openai-api-key
AI_ROUTING_ENABLED=false
OPENAI_ROUTING_MODEL=gpt-5-nano
AI_ROUTING_MAX_GENERATIONS_PER_REPORT_PER_DAY=2

# Optional notification/email integration for later
RESEND_API_KEY=your-resend-api-key
ISSUE_REPORT_FROM_EMAIL="District 7 <reports@example.org>"
