NEXT_PUBLIC_APP_URL=http://localhost:3000
DATA_DIR=.data
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Automatic database + attachment snapshots (normally enabled only in hosting)
AUTOMATED_BACKUPS_ENABLED=false
AUTOMATED_BACKUP_INTERVAL_HOURS=24
AUTOMATED_BACKUP_RETENTION_COUNT=3
AUTOMATED_BACKUP_INITIAL_DELAY_SECONDS=60

# Encrypted off-site snapshots in S3-compatible object storage. The scheduled
# job uploads, downloads, decrypts, and integrity-checks every new snapshot.
OFFSITE_BACKUPS_ENABLED=false
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_REGION=us-east-1
OFFSITE_BACKUP_ENDPOINT=
OFFSITE_BACKUP_ACCESS_KEY_ID=
OFFSITE_BACKUP_SECRET_ACCESS_KEY=
OFFSITE_BACKUP_ENCRYPTION_SECRET=
OFFSITE_BACKUP_FORCE_PATH_STYLE=true
OFFSITE_BACKUP_PREFIX=district-7
OFFSITE_BACKUP_RETENTION_COUNT=14

# Staff auth. STAFF_PASSWORD is the local/demo fallback and Karl's retained
# production password. Other production staff use the individual password
# hashes configured in src/lib/staff-passwords.ts.
STAFF_PASSWORD=district7-local
STAFF_SESSION_SECRET=
STAFF_SESSION_MAX_AGE_HOURS=12

# Address geocoding
GEOCODING_PROVIDER=census
GEOCODING_CENSUS_BENCHMARK=Public_AR_Current
GEOCODING_TIMEOUT_MS=4000
LOCATION_LOOKUP_TIMEOUT_MS=5000
DISTRICT_7_MATCH_KEYWORDS=
DISTRICT_7_OUTSIDE_KEYWORDS=

# Intake hardening
REPORT_MAX_PHOTOS=4
REPORT_RATE_LIMIT_ENABLED=true
REPORT_RATE_LIMIT_WINDOW_MINUTES=60
REPORT_RATE_LIMIT_MAX_PER_IP=12
REPORT_RATE_LIMIT_MAX_PER_EMAIL=4
RATE_LIMIT_SECRET=

# Optional AI routing
OPENAI_API_KEY=your-openai-api-key
AI_ROUTING_ENABLED=false
OPENAI_ROUTING_MODEL=gpt-5-nano
AI_ROUTING_MAX_GENERATIONS_PER_REPORT_PER_DAY=2

# Optional notification/email integration for later
RESEND_API_KEY=your-resend-api-key
ISSUE_REPORT_FROM_EMAIL="District 7 <reports@example.org>"
