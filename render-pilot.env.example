NEXT_PUBLIC_APP_URL=https://YOUR-CUSTOM-DOMAIN-OR-RENDER-URL
DATA_DIR=/var/data
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

STAFF_PASSWORD=REPLACE_WITH_STRONG_STAFF_PASSWORD
STAFF_SESSION_SECRET=REPLACE_WITH_LONG_RANDOM_SESSION_SECRET
STAFF_SESSION_MAX_AGE_HOURS=12

GEOCODING_PROVIDER=census
GEOCODING_CENSUS_BENCHMARK=Public_AR_Current
GEOCODING_TIMEOUT_MS=4000
LOCATION_LOOKUP_TIMEOUT_MS=5000

REPORT_MAX_PHOTOS=4
REPORT_RATE_LIMIT_ENABLED=true
REPORT_RATE_LIMIT_WINDOW_MINUTES=60
REPORT_RATE_LIMIT_MAX_PER_IP=12
REPORT_RATE_LIMIT_MAX_PER_EMAIL=4
RATE_LIMIT_SECRET=REPLACE_WITH_LONG_RANDOM_RATE_LIMIT_SECRET

AI_ROUTING_ENABLED=false
OPENAI_ROUTING_MODEL=gpt-5-nano
AI_ROUTING_MAX_GENERATIONS_PER_REPORT_PER_DAY=2
OPENAI_API_KEY=OPTIONAL_UNTIL_AI_ROUTING_IS_ENABLED

STAFF_ASSIGNMENT_EMAIL_ENABLED=true
STAFF_ASSIGNMENT_EMAIL_PROVIDER=smtp
ISSUE_REPORT_FROM_EMAIL="District 7 Issue Reporter <YOUR_GMAIL_ADDRESS@gmail.com>"

# Gmail SMTP pilot option. Use a Google app password, not the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASSWORD=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD
STAFF_ASSIGNMENT_EMAIL_BCC=YOUR_GMAIL_ADDRESS@gmail.com

# Resend option. Use this only after a sending domain is verified in Resend.
RESEND_API_KEY=
